#!/usr/bin/env python3
"""credential_process helper: SSO creds on demand, browser login only when needed.

Usage: sso-credential-process SOURCE_PROFILE

SOURCE_PROFILE is a profile with normal sso_session/sso_account_id/sso_role_name
keys. Point a sibling profile at this script so every consumer (aws CLI, SDKs,
agent harnesses) resolves through one choke point:

    [profile Griptape]
    credential_process = /Users/you/.config/aws/sso-credential-process Griptape-sso

Keys must not be combined in one profile: botocore prefers sso over
credential_process, the JS SDK prefers credential_process over sso.

Caches the exported creds because `aws configure export-credentials` costs ~1s
and callers that build a fresh client per request pay it every time.

Pattern: https://builder.aws.com/content/3I2rslXnT32uHwxioei5dvcEoUH/automatic-sso-sign-in-for-codex-and-claude-code-on-amazon-bedrock
"""

import fcntl
import json
import os
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

REFRESH_MARGIN = timedelta(minutes=5)
LOGIN_TIMEOUT = 300
EXPORT_TIMEOUT = 60
GUARD_ENV = "AWS_SSO_CREDENTIAL_PROCESS_ACTIVE"
# Ambient creds must not shadow --profile in child calls.
STRIP_ENV = (
    "AWS_PROFILE",
    "AWS_DEFAULT_PROFILE",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_CREDENTIAL_EXPIRATION",
)


def die(msg: str) -> None:
    print(f"sso-credential-process: {msg}", file=sys.stderr)
    sys.exit(1)


def child_env() -> dict[str, str]:
    env = {k: v for k, v in os.environ.items() if k not in STRIP_ENV}
    env[GUARD_ENV] = "1"
    return env


def cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")
    path = Path(base) / "aws-sso-credential-process"
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    return path


def fresh(creds: dict) -> bool:
    raw = creds.get("Expiration")
    if not raw:
        return False
    try:
        expires = datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except ValueError:
        return False
    if expires.tzinfo is None:
        expires = expires.replace(tzinfo=timezone.utc)
    return expires - REFRESH_MARGIN > datetime.now(timezone.utc)


def read_cache(path: Path) -> dict | None:
    try:
        creds = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    return creds if isinstance(creds, dict) and fresh(creds) else None


def write_cache(path: Path, creds: dict) -> None:
    tmp = path.with_suffix(".tmp")
    try:
        with open(tmp, "w", opener=lambda p, f: os.open(p, f, 0o600)) as fh:
            json.dump(creds, fh)
        tmp.replace(path)
    except OSError:
        tmp.unlink(missing_ok=True)


def export_credentials(profile: str) -> dict | None:
    """Exported creds, or None when an interactive login is required."""
    result = subprocess.run(
        ["aws", "configure", "export-credentials", "--profile", profile, "--format", "process"],
        capture_output=True,
        text=True,
        env=child_env(),
        timeout=EXPORT_TIMEOUT,
    )
    if result.returncode != 0:
        return None
    try:
        creds = json.loads(result.stdout)
    except ValueError:
        die(f"export-credentials returned non-JSON for profile {profile!r}")
    if not creds.get("AccessKeyId"):
        die(f"export-credentials returned no keys for profile {profile!r}")
    return creds


def login(profile: str) -> None:
    # stdout belongs to the credential_process protocol; CLI chatter goes to stderr.
    result = subprocess.run(
        ["aws", "sso", "login", "--profile", profile],
        stdout=sys.stderr.fileno(),
        stderr=sys.stderr.fileno(),
        env=child_env(),
        timeout=LOGIN_TIMEOUT,
    )
    if result.returncode != 0:
        die(f"`aws sso login --profile {profile}` failed (exit {result.returncode})")


def resolve(profile: str, cache: Path) -> dict:
    creds = export_credentials(profile)
    if creds:
        return creds

    lock_path = cache.with_suffix(".lock")
    with open(lock_path, "w", opener=lambda p, f: os.open(p, f, 0o600)) as lock:
        # One browser login per profile; waiters re-export once it lands.
        fcntl.flock(lock, fcntl.LOCK_EX)
        creds = read_cache(cache) or export_credentials(profile)
        if creds:
            return creds
        login(profile)
        creds = export_credentials(profile)
    if not creds:
        die(f"still no credentials for profile {profile!r} after login")
    return creds


def main() -> None:
    if len(sys.argv) != 2:
        die("usage: sso-credential-process SOURCE_PROFILE")
    if os.environ.get(GUARD_ENV):
        die("recursive invocation; SOURCE_PROFILE must not use credential_process")

    profile = sys.argv[1]
    cache = cache_dir() / f"{profile}.json"

    creds = read_cache(cache)
    if not creds:
        creds = resolve(profile, cache)
        write_cache(cache, creds)

    json.dump(creds, sys.stdout)


if __name__ == "__main__":
    main()
